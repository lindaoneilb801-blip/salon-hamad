                        <span class="status-label text-[10px] text-emerald-400 font-bold block mt-0.5">متاح 🟢</span>
                    </div>
                    <div class="selectable-box rounded-xl p-3 text-center time-slot" data-time="9:00 مساءً" onclick="selectTime('9:00 مساءً', this)">
                        <div class="text-sm font-black font-cairo text-gray-100">9:00 مساءً</div>
                        <span class="status-label text-[10px] text-emerald-400 font-bold block mt-0.5">متاح 🟢</span>
                    </div>
                    <div class="selectable-box rounded-xl p-3 text-center time-slot" data-time="10:00 مساءً" onclick="selectTime('10:00 مساءً', this)">
                        <div class="text-sm font-black font-cairo text-gray-100">10:00 مساءً</div>
                        <span class="status-label text-[10px] text-emerald-400 font-bold block mt-0.5">متاح 🟢</span>
                    </div>
                    <div class="selectable-box rounded-xl p-3 text-center time-slot" data-time="11:00 ليلاً" onclick="selectTime('11:00 ليلاً', this)">
                        <div class="text-sm font-black font-cairo text-gray-100">11:00 ليلاً</div>
                        <span class="status-label text-[10px] text-emerald-400 font-bold block mt-0.5">متاح 🟢</span>
                    </div>
                    <div class="selectable-box rounded-xl p-3 text-center time-slot" data-time="12:00 منتصف الليل" onclick="selectTime('12:00 منتصف الليل', this)">
                        <div class="text-sm font-black font-cairo text-gray-100">12:00 بالليل</div>
                        <span class="status-label text-[10px] text-emerald-400 font-bold block mt-0.5">متاح 🟢</span>
                    </div>
                    <div class="selectable-box rounded-xl p-3 text-center time-slot col-span-2 sm:col-span-2 border-maroon-400" data-time="1:00 ليلاً" onclick="selectTime('1:00 ليلاً', this)">
                        <div class="text-sm font-black font-cairo text-maroon-300">1:00 ليلاً 🔥</div>
                        <span class="status-label text-[10px] text-emerald-400 font-bold block mt-0.5">متاح 🟢</span>
                    </div>
                </div>
            </section>

            <!-- SECTION 5: CLIENT INFO -->
            <section class="glass-card rounded-3xl p-5 sm:p-6 space-y-4 border-r-4 border-r-maroon-400">
                <h2 class="text-xl sm:text-2xl font-black font-changa text-white flex items-center gap-3">
                    <i class="fa-solid fa-id-card text-maroon-400 text-2xl"></i>
                    ٥. معلومات الزبون
                </h2>

                <div class="space-y-4">
                    <div>
                        <label class="block text-xs sm:text-sm font-black font-tajawal text-gray-200 mb-2">اسم الزبون الكريم:</label>
                        <div class="relative">
                            <input type="text" id="client-name" placeholder="أدخل اسمك الكريم الثلاثي..." class="w-full bg-[#080204] border-2 border-maroon-700/60 rounded-2xl px-5 py-4 pr-12 text-sm sm:text-base font-bold text-white placeholder-gray-500 focus:outline-none focus:border-maroon-400 focus:ring-2 focus:ring-maroon-400/50 transition-all">
                            <i class="fa-solid fa-user absolute top-4 sm:top-5 right-4 text-maroon-400 text-lg"></i>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs sm:text-sm font-black font-tajawal text-gray-200 mb-2">رقم الموبايل / الواتساب:</label>
                        <div class="relative">
                            <input type="tel" id="client-phone" placeholder="07XXXXXXXXX" class="w-full bg-[#080204] border-2 border-maroon-700/60 rounded-2xl px-5 py-4 pr-12 text-sm sm:text-base font-bold text-white placeholder-gray-500 focus:outline-none focus:border-maroon-400 focus:ring-2 focus:ring-maroon-400/50 transition-all text-left" dir="ltr">
                            <i class="fa-solid fa-phone absolute top-4 sm:top-5 right-4 text-maroon-400 text-lg"></i>
                        </div>
                    </div>
                </div>
            </section>

            <!-- SUBMIT BUTTON -->
            <div class="pt-2">
                <button onclick="submitBooking()" class="w-full btn-flame rounded-2xl py-5 px-6 flex items-center justify-center gap-4 text-xl sm:text-2xl font-black font-changa text-white tracking-wide cursor-pointer border-2 border-maroon-300/40">
                    <i class="fa-brands fa-whatsapp text-3xl animate-bounce"></i>
                    <span>تثبيت الحجز الملكي عبر الواتساب 🔥</span>
                </button>
            </div>

        </div>

        <!-- FOOTER & DESIGNER CREDITS -->
        <footer class="glass-card rounded-3xl p-6 text-center space-y-4 border-t-2 border-t-maroon-500 font-cairo">
            <div class="space-y-1">
                <p class="text-base font-black text-white">👑 صالون الكوافير حمد 👑</p>
                <p class="text-xs font-bold text-maroon-300">العنوان: الانبار - حديثة - حي العسكري</p>
            </div>

            <div class="w-24 h-0.5 bg-gradient-to-r from-transparent via-maroon-500 to-transparent mx-auto"></div>

            <!-- Designer Rights -->
            <div class="bg-black/60 p-4 rounded-2xl border border-maroon-800/80 space-y-2">
                <p class="text-xs font-black text-gray-300 tracking-wider">
                    ✨ تم التصميم والتطوير بواسطة: <span class="text-maroon-400 text-sm font-bold">المصمم علي حسين علي</span> ✨
                </p>
                
                <a href="https://instagram.com/a_lgi6" target="_blank" class="inline-flex items-center gap-2 bg-gradient-to-r from-purple-900/60 via-pink-900/60 to-maroon-900/60 px-4 py-2 rounded-xl border border-pink-500/40 text-xs font-black text-pink-300 hover:scale-105 transition-transform">
                    <i class="fa-brands fa-instagram text-base text-pink-400"></i>
                    <span>a_lgi6@</span>
                </a>
            </div>
        </footer>

    </div>

    <!-- SCRIPT LOGIC -->
    <script>
        const bookingState = {
            barber: '',
            barberPhone: '',
            service: '',
            day: '',
            time: ''
        };

        // Select Barber
        function selectBarber(name, phone, element) {
            bookingState.barber = name;
            bookingState.barberPhone = phone;

            const parent = element.parentElement;
            parent.querySelectorAll('.selectable-box').forEach(el => el.classList.remove('selected'));
            element.classList.add('selected');

            vibrate();
        }

        // Select Service
        function selectService(serviceName, element) {
            bookingState.service = serviceName;

            const parent = element.parentElement;
            parent.querySelectorAll('.selectable-box').forEach(el => el.classList.remove('selected'));
            element.classList.add('selected');

            vibrate();
        }

        // Select Day
        function selectDay(dayName, element) {
            bookingState.day = dayName;

            const parent = element.parentElement;
            parent.querySelectorAll('.selectable-box').forEach(el => el.classList.remove('selected'));
            element.classList.add('selected');

            vibrate();
        }

        // Select Time Slot
        function selectTime(timeStr, element) {
            if (element.classList.contains('booked-slot')) {
                showToast('هذا الموعد محجوز مسبقاً! يرجى اختيار وقت آخر 🔒');
                return;
            }

            bookingState.time = timeStr;

            const parent = element.parentElement;
            parent.querySelectorAll('.selectable-box').forEach(el => el.classList.remove('selected'));
            element.classList.add('selected');

            vibrate();
        }

        function vibrate() {
            if (navigator.vibrate) navigator.vibrate(40);
        }

        // Lock & Storage System for Bookings
        function getBookedSlots() {
            return JSON.parse(localStorage.getItem('hamad_booked_slots') || '[]');
        }

        function renderBookedSlots() {
            const booked = getBookedSlots();
            const slots = document.querySelectorAll('.time-slot');

            slots.forEach(slot => {
                const timeValue = slot.getAttribute('data-time');
                const label = slot.querySelector('.status-label');

                if (booked.includes(timeValue)) {
                    slot.classList.add('booked-slot');
                    slot.classList.remove('selected');
                    if (label) {
                        label.textContent = 'محجوز 🔒';
                        label.className = 'status-label text-[10px] text-rose-500 font-bold block mt-0.5';
                    }
                } else {
                    slot.classList.remove('booked-slot');
                    if (label) {
                        label.textContent = 'متاح 🟢';
                        label.className = 'status-label text-[10px] text-emerald-400 font-bold block mt-0.5';
                    }
                }
            });
        }

        function lockSlot(timeValue) {
            const booked = getBookedSlots();
            if (!booked.includes(timeValue)) {
                booked.push(timeValue);
                localStorage.setItem('hamad_booked_slots', JSON.stringify(booked));
            }
            renderBookedSlots();
        }

        function resetBookedSlots() {
            localStorage.removeItem('hamad_booked_slots');
            renderBookedSlots();
            showToast('تم إعادة فتح جميع الحجوزات بنجاح 🔄');
        }

        // Submit Booking to WhatsApp
        function submitBooking() {
            const name = document.getElementById('client-name').value.trim();
            const phone = document.getElementById('client-phone').value.trim();

            if (!bookingState.barber) {
                showToast('يرجى اختيار الكوافير المفضل أولاً ✂️');
                return;
            }
            if (!bookingState.service) {
                showToast('يرجى اختيار نوع الكصة أو الخدمة 💈');
                return;
            }
            if (!bookingState.day) {
                showToast('يرجى اختيار اليوم المناسب 📅');
                return;
            }
            if (!bookingState.time) {
                showToast('يرجى اختيار وقت الموعد ⏰');
                return;
            }
            if (!name) {
                showToast('يرجى ادخال اسم الزبون الكريم 👤');
                document.getElementById('client-name').focus();
                return;
            }
            if (!phone) {
                showToast('يرجى ادخال رقم الموبايل 📱');
                document.getElementById('client-phone').focus();
                return;
            }

            // Confetti Animation
            if (typeof confetti === 'function') {
                confetti({
                    particleCount: 180,
                    spread: 120,
                    origin: { y: 0.6 },
                    colors: ['#E61C40', '#C2002B', '#FFFFFF', '#FFD700', '#FF6B8B']
                });
            }

            // Lock this slot
            lockSlot(bookingState.time);

            // Target Phone (default to Hamad's number if not selected)
            const targetPhone = bookingState.barberPhone || '+9647756534000';

            // WhatsApp Structured Message
            const message = `👑 *طلب حجز ملكي جديد - صالون الكوافير حمد* 👑%0A` +
                `============================%0A` +
                `👤 *اسم الزبون:* ${encodeURIComponent(name)}%0A` +
                `📱 *رقم الموبايل:* ${encodeURIComponent(phone)}%0A` +
                `💈 *الكوافير المطلوب:* ${encodeURIComponent(bookingState.barber)}%0A` +
                `✂️ *الخدمة:* ${encodeURIComponent(bookingState.service)}%0A` +
                `📅 *اليوم:* ${encodeURIComponent(bookingState.day)}%0A` +
                `⏰ *الوقت:* ${encodeURIComponent(bookingState.time)}%0A` +
                `📍 *العنوان:* الانبار - حديثة - حي العسكري%0A` +
                `============================%0A` +
                `يرجى تأكيد الحجز وإرسال الموافقة وشكراً لكم 🔥`;

            setTimeout(() => {
                window.open(`https://wa.me/${targetPhone}?text=${message}`, '_blank');
            }, 600);
        }

        // Custom Notification Toast
        function showToast(message) {
            let toast = document.getElementById('custom-toast');
            if (!toast) {
                toast = document.createElement('div');
                toast.id = 'custom-toast';
                toast.className = 'fixed bottom-8 left-1/2 -translate-x-1/2 z-50 bg-maroon-800 text-white font-black font-tajawal text-sm px-6 py-3.5 rounded-2xl border-2 border-maroon-400 flex items-center gap-3 transition-all duration-300 opacity-0 pointer-events-none shadow-2xl';
                document.body.appendChild(toast);
            }
            toast.innerHTML = `<i class="fa-solid fa-circle-exclamation text-amber-300 text-lg"></i> <span>${message}</span>`;
            toast.classList.remove('opacity-0', 'pointer-events-none');

            setTimeout(() => {
                toast.classList.add('opacity-0', 'pointer-events-none');
            }, 3000);
        }

        // Canvas Particle Effects
        const canvas = document.getElementById('bg-canvas');
        const ctx = canvas.getContext('2d');
        let particles = [];

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        class Particle {
            constructor() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.size = Math.random() * 2 + 0.5;
                this.speedY = Math.random() * -0.6 - 0.2;
                this.speedX = (Math.random() - 0.5) * 0.4;
                this.opacity = Math.random() * 0.7 + 0.2;
            }
            update() {
                this.y += this.speedY;
                this.x += this.speedX;
                if (this.y < 0) {
                    this.y = canvas.height;
                    this.x = Math.random() * canvas.width;
                }
            }
            draw() {
                ctx.fillStyle = `rgba(230, 28, 64, ${this.opacity})`;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        for (let i = 0; i < 45; i++) particles.push(new Particle());

        function animateParticles() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles.forEach(p => { p.update(); p.draw(); });
            requestAnimationFrame(animateParticles);
        }
        animateParticles();

        // Initial Load
        document.addEventListener('DOMContentLoaded', renderBookedSlots);
    </script>
</body>
</html>
